{
  "name": "serverless-order-pipeline",
  "version": "1.0.0",
  "description": "Serverless order fulfillment pipeline: API Gateway -> Lambda -> SQS -> Step Functions -> DynamoDB/SNS",
  "main": "index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src tests",
    "offline": "serverless offline start",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
    "logs:createOrder": "serverless logs -f createOrder -t"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/client-sns": "^3.600.0",
    "@aws-sdk/client-sfn": "^3.600.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "serverless": "^3.38.0",
    "serverless-step-functions": "^3.15.0",
    "serverless-offline": "^13.3.0",
    "serverless-dynamodb-local": "^0.2.40",
    "jest": "^29.7.0",
    "aws-sdk-client-mock": "^3.0.0",
    "aws-sdk-client-mock-jest": "^3.0.0",
    "eslint": "^8.56.0"
  }
}
